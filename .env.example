# คัดลอกเป็น .env.local แล้วแก้ค่าให้ตรงกับ MongoDB / โฮสต์ของคุณ
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/calibration_db

# สร้างด้วย: openssl rand -base64 32  (Windows: ใช้ WSL หรือเว็บ random base64)
NEXTAUTH_SECRET=your-random-secret-at-least-32-chars
NEXTAUTH_URL=http://localhost:3000

# — Vercel: Settings → Environment Variables (Production) ใส่สามตัวเดียวกัน
# NEXTAUTH_URL ต้องเป็น URL จริงของดีพลอย เช่น https://calibration-app-xxx.vercel.app
# MongoDB Atlas: Network Access อนุญาต 0.0.0.0/0 หรือ 104.0.0.0/7 (Vercel IP ช่วง) สำหรับ serverless
